proto = "0.58.2"
moon = "2.3.5"
rumdl = "0.2.28"
node = "26.4.0"
npm = "11.18.0"
rust = "1.96.1"
go = "1.26.4"
golangci-lint = "2.12.2"
cyclonedx-gomod = "1.10.0"
python = "3.14.6"
zig = "0.15.2"
"npm:cspell" = "10.0.1"
"npm:tree-sitter-cli" = "0.26.10"
"cargo:cargo-binstall" = "1.20.1"
"cargo:cargo-deny" = "0.19.9"
"ruff"= "0.15.20"
"uv"= "0.11.26"
"ty"= "0.0.56"

[plugins.tools]
cyclonedx-gomod = "file://.proto/plugins/cyclonedx-gomod.toml"
golangci-lint = "file://.proto/plugins/golangci-lint.toml"
rumdl = "file://.proto/plugins/rumdl.toml"
zig = "file://.proto/plugins/zig.toml"
ruff = "file://.proto/plugins/ruff.toml"
uv = "file://.proto/plugins/uv.toml"
ty = "file://.proto/plugins/ty.toml"
