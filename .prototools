proto = "0.63.2"
java = "android"
gradle = "9.8.2"
just = "1.59.0"
moon = "2.6.3"
"asdf:git-lfs" = "3.8.0"
rumdl = "0.3.0"
node = "26.12.1"
npm = "12.2.1"
rust = "1.99.1"
go = "1.27.3"
golangci-lint = "2.15.0"
cyclonedx-gomod = "1.12.0"
quarto = "1.11.6"
pandoc = "3.10.0"
typst = "0.15.1"
typstyle = "0.15.2"
tinymist = "0.15.10"
shuck = "0.2.7"
python = "3.15.1"
zig = "0.15.2"
tofu = "1.13.2"
zellij = "0.45.1"
wt = "0.81.0"
"npm:cspell" = "10.4.0"
"npm:oxlint" = "1.89.0"
"npm:oxfmt" = "0.74.0"
"npm:tree-sitter-cli" = "0.27.1"
"npm:typescript-language-server" = "6.0.2"
"npm:yaml-language-server" = "2.0.0"
"cargo:cargo-binstall" = "1.26.0"
"cargo:cargo-deny" = "0.20.2"
"ruff"= "0.17.1"
"uv"= "0.13.5"
"ty"= "0.0.90"

[plugins.tools]
gradle = "file://.proto/plugins/gradle.toml"
just = "file://.proto/plugins/just.toml"
cyclonedx-gomod = "file://.proto/plugins/cyclonedx-gomod.toml"
quarto = "file://.proto/plugins/quarto.toml"
pandoc = "file://.proto/plugins/pandoc.toml"
typst = "file://.proto/plugins/typst.toml"
typstyle = "file://.proto/plugins/typstyle.toml"
tinymist = "file://.proto/plugins/tinymist.toml"
shuck = "file://.proto/plugins/shuck.toml"
golangci-lint = "file://.proto/plugins/golangci-lint.toml"
rumdl = "file://.proto/plugins/rumdl.toml"
zig = "file://.proto/plugins/zig.toml"
tofu = "file://.proto/plugins/tofu.toml"
zellij = "file://.proto/plugins/zellij.toml"
wt = "file://.proto/plugins/worktrunk.toml"
ruff = "file://.proto/plugins/ruff.toml"
uv = "file://.proto/plugins/uv.toml"
ty = "file://.proto/plugins/ty.toml"

# Keep the Java pin on the Android-compatible Java 21 release line.
# tools/outdated.py refreshes this alias; proto outdated preserves aliases.
[tools.java.aliases]
android = "temurin-21.0.12-v1+1"
