FROM sakura-dev-tools:00-base-os AS proverif-builder

ARG PROVERIF_VERSION
ARG PROVERIF_SHA256

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends ocaml; \
    mkdir /tmp/proverif; \
    cd /tmp/proverif; \
    curl --fail --location --retry 3 \
        "https://proverif.inria.fr/proverif${PROVERIF_VERSION}.tar.gz" --output source.tar.gz; \
    printf '%s  %s\n' "$PROVERIF_SHA256" source.tar.gz | sha256sum --check; \
    tar -xzf source.tar.gz --strip-components=1 --no-same-owner; \
    ./build -nointeract native; \
    install -Dm755 proverif /artifacts/bin/proverif; \
    install -Dm644 LICENSE /artifacts/doc/LICENSE

FROM sakura-dev-tools:05-pdf2htmlex

LABEL org.opencontainers.image.source="https://github.com/Sakura-Industries-LLC/sakura-dev-tools"

ARG DRAWIO_VERSION

# Use the desktop exporter offline, with a virtual display for Electron.
# Keep this installation late so renderer updates preserve the toolchain cache.
RUN set -eux; \
    architecture="$(dpkg --print-architecture)"; \
    case "$architecture" in amd64|arm64) ;; *) exit 1 ;; esac; \
    curl --fail --location --retry 3 \
        "https://github.com/jgraph/drawio-desktop/releases/download/v${DRAWIO_VERSION}/drawio-${architecture}-${DRAWIO_VERSION}.deb" \
        --output /tmp/drawio.deb; \
    apt-get update; \
    apt-get install -y --no-install-recommends /tmp/drawio.deb xvfb xauth libgbm1; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/* /tmp/drawio.deb

COPY --chmod=755 tools/drawio.sh /usr/local/bin/drawio
COPY --from=proverif-builder /artifacts/bin/proverif /usr/local/bin/proverif
COPY --from=proverif-builder /artifacts/doc/LICENSE /usr/local/share/doc/proverif/LICENSE

RUN mkdir /repo
RUN env

WORKDIR /repo
