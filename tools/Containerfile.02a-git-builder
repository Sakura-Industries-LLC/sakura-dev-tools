FROM sakura-dev-tools:02-rust

ARG GIT_VERSION

WORKDIR /build

RUN set -eux; \
    curl --fail --location --proto '=https' --tlsv1.2 \
        --retry 3 \
        "https://github.com/git/git/archive/refs/tags/v${GIT_VERSION}.zip" \
        --output git.zip; \
    unzip -q git.zip; \
    cd "git-${GIT_VERSION}"; \
    make configure; \
    ./configure --prefix=/opt/git; \
    make -j"$(nproc)"; \
    make install INSTALL_SYMLINKS=YesPlease; \
    rm -rf /build
