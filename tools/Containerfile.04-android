FROM sakura-dev-tools:03-go

ENV ANDROID_HOME=/opt/android-sdk
ENV ANDROID_SDK_ROOT=$ANDROID_HOME
ENV ANDROID_USER_HOME=/root/.android
ENV ANDROID_AVD_HOME=$ANDROID_USER_HOME/avd
ENV ANDROID_NDK_HOME=/opt/android-ndk
ENV ANDROID_NDK_ROOT=$ANDROID_NDK_HOME
ENV NDK_HOME=$ANDROID_NDK_HOME
ENV PATH="$ANDROID_HOME/cmdline-tools/latest/bin:$ANDROID_HOME/platform-tools:$ANDROID_HOME/emulator:$ANDROID_NDK_HOME:$PATH"

COPY .env tools/install-android.py /toolchain/android/

RUN set -eux; \
    mkdir -p "$ANDROID_HOME" "$ANDROID_AVD_HOME"; \
    if [ "$(dpkg --print-architecture)" = amd64 ]; then \
        python3 /toolchain/android/install-android.py; \
    else \
        echo 'Android SDK, NDK and emulator require the linux/amd64 image.'; \
    fi
